SPRING_MAIL_USERNAME=your_gmail@gmail.com
SPRING_MAIL_PASSWORD=your_app_password
GEMINI_API_KEY=your_gemini_api_key
# Google OAuth Web client id (Google Cloud Console > Credentials).
# Used by the backend (token verification) and the frontend (sign-in button).
# No client secret is needed: this app uses the Google Identity Services
# ID-token flow (frontend gets an ID token with the client id, backend only
# verifies it). A GOOGLE_CLIENT_SECRET would only be required if we switch to
# the server-side authorization-code flow (exchanging a code for tokens).
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Gmail Import feature (OAuth 2.0 authorization-code flow + Gmail API).
# Required only for Gmail Import; the plain Google sign-in (ID-token) flow does not need them.
# Create an OAuth 2.0 "Web application" client in Google Cloud Console > Credentials,
# enable the Gmail API, and add GOOGLE_OAUTH_REDIRECT_URI as an authorized redirect URI.
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4200/gmail-import
# Secret used to encrypt Gmail tokens stored in the database (use a strong random value in prod).
GMAIL_TOKEN_ENCRYPTION_SECRET=change_me_to_a_long_random_string
# Optional: how many recent inbox messages to scan per import run (default 10).
# GMAIL_IMPORT_MAX_MESSAGES=10

# Optional overrides (defaults shown):
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_AUTH=truecan
# SPRING_MAIL_STARTTLS=true
# GEMINI_MODEL=gemini-2.5-flash
