  GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Real email sending, for example Gmail SMTP.
# Copy this file to .env and fill these values locally.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=yourgmail@gmail.com
SPRING_MAIL_PASSWORD=your_google_app_password
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS=true
